# CADUCEUS local Floci E2E defaults
# Copy to .env if you want to override test secrets:
#   cp tests/.env.example tests/.env

JWT_SECRET=caduceus-local-test-secret
INBOUND_WEBHOOK_SECRET=caduceus-local-inbound-secret
EVENTS_WEBHOOK_SECRET=caduceus-local-events-secret

# Floci-backed AWS adapters
SMS_ADAPTER=aws
SMTP_ADAPTER=aws
AWS_ENDPOINT_URL=http://floci:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SES_FROM_ADDRESS=admin@example.com
