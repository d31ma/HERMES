# HERMES Lambda container image for mail.del.ma
FROM oven/bun:1.3.11
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --production

# Expose the serve entry point (workaround for tachyon exports map)
RUN sed -i 's/"\.\/compiler"/".\/src\/cli\/serve.js": ".\/src\/cli\/serve.js",\n    ".\/compiler"/' \
  node_modules/@d31ma/tachyon/package.json 2>/dev/null || true

COPY browser ./browser
COPY server ./server
COPY scripts/entry.mjs scripts/lambda.mjs ./scripts/
COPY jsconfig.json ./

# Pre-build the frontend
RUN bun run bundle 2>&1 || true \
  && mkdir -p /opt/build/manifests /opt/build/dist \
  && cp -r node_modules/@d31ma/tachyon/src/shared/manifests/* /opt/build/manifests/ 2>/dev/null || true \
  && cp -r dist/* /opt/build/dist/ 2>/dev/null || true

# Replace build output dirs with symlinks to /tmp for Lambda's writable fs
RUN rm -rf node_modules/@d31ma/tachyon/src/shared/manifests dist \
  && ln -s /tmp/tachyon-manifests node_modules/@d31ma/tachyon/src/shared/manifests \
  && ln -s /tmp/dist dist

# Entrypoint: init writable dirs from pre-built stash, then start HERMES
RUN printf '#!/bin/sh\n\
mkdir -p /tmp/tachyon-manifests /tmp/dist\n\
cp -r /opt/build/manifests/* /tmp/tachyon-manifests/ 2>/dev/null || true\n\
cp -r /opt/build/dist/* /tmp/dist/ 2>/dev/null || true\n\
exec bun scripts/lambda.mjs --full\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

ENV NODE_ENV=production
ENV YON_DIST_PATH=/tmp/dist
ENTRYPOINT ["/entrypoint.sh"]
