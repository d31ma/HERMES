# ── HERMES Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Server ───────────────────────────────────────────────────────────────

# Bind address (default: 0.0.0.0 in Docker, 127.0.0.1 locally)
HOST=0.0.0.0

# HTTP port (default: 8080 in Docker)
PORT=8080

# ── Database (Fylo) ──────────────────────────────────────────────────────

# Local file-backed persistence directory (default: /data in Docker)
FYLO_ROOT=./.data

# S3 bucket for the query index — when set, Fylo stores its prefix index
# in S3 via Bun.S3Client instead of the local filesystem. Document bodies
# still live under FYLO_ROOT. Leave unset for local-only operation.
# Requires AWS credentials (env vars or IAM role) and s3:GetObject /
# s3:PutObject / s3:DeleteObject permissions on the bucket.
# FYLO_S3_BUCKET=hermes-index

# Optional S3 overrides (fall back to standard AWS env vars if unset):
# FYLO_S3_REGION=us-east-1
# FYLO_S3_ENDPOINT=http://localstack:4566
# FYLO_S3_ACCESS_KEY_ID=test
# FYLO_S3_SECRET_ACCESS_KEY=test

# ── Security (required) ──────────────────────────────────────────────────

# JWT signing key — must be a strong random value in production
JWT_SECRET=change-me-to-a-random-secret

# HMAC key for inbound email webhook authentication
INBOUND_WEBHOOK_SECRET=change-me-too

# Optional webhook secret for bounce/complaint event endpoints
# EVENTS_WEBHOOK_SECRET=

# ── Attachments ──────────────────────────────────────────────────────────

# Directory for storing email attachment files (required in production)
# Defaults to ${FYLO_ROOT}/attachments in development
ATTACHMENT_ROOT=

# ── Web Push Notifications ───────────────────────────────────────────────

# Generate VAPID keys with: bun node_modules/.bin/web-push generate-vapid-keys
# Required in production unless WEB_PUSH_DISABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact URI for Web Push (e.g. mailto:admin@example.com)
VAPID_SUBJECT=

# Set to true to disable push delivery (e.g. in dev / controlled environments)
# WEB_PUSH_DISABLED=true

# ── Adapters ─────────────────────────────────────────────────────────────

# SMS provider: console | aws | azure | twilio
SMS_ADAPTER=console

# SMTP provider: console | aws | azure | gcp | sendgrid | smtp
SMTP_ADAPTER=console

# ── AWS (SNS for SMS, SES for email) ──────────────────────────────────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Azure Communication Services ──────────────────────────────────────────
# AZURE_COMMUNICATION_ENDPOINT=https://your-resource.communication.azure.com
# AZURE_COMMUNICATION_KEY=
# AZURE_SMS_FROM=+1234567890
# AZURE_EMAIL_FROM=hermes@your-domain.com

# ── GCP (Gmail API for email) ─────────────────────────────────────────────
# GCP_SERVICE_ACCOUNT_EMAIL=hermes@project.iam.gserviceaccount.com
# GCP_SERVICE_ACCOUNT_KEY=<base64-encoded service account JSON>
# GCP_MAIL_FROM=hermes@your-domain.com

# ── Twilio (SMS) ──────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── SendGrid (email) ──────────────────────────────────────────────────────
# SENDGRID_API_KEY=
# SENDGRID_FROM=hermes@your-domain.com

# ── Generic SMTP Relay (for self-hosted or third-party MTAs) ──────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hermes@your-domain.com

# ── SES fallback from address ─────────────────────────────────────────────
# SES_FROM_ADDRESS=hermes@your-domain.com

# ── OAuth Social Login ───────────────────────────────────────────────────

# Common redirect URI for all OAuth providers
# Must match the redirect URI registered with each provider
OAUTH_REDIRECT_URI=https://your-domain.com/auth/oauth/callback

# Optional default domain assigned to auto-created OAuth users
# OAUTH_DEFAULT_DOMAIN=example.com

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps)
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Apple Sign In (https://developer.apple.com/account/resources/identifiers/list)
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=

# ── Test / Development ───────────────────────────────────────────────────

# Enable test-only routes (e.g. seed endpoints) — only in NODE_ENV=test
# HERMES_ENABLE_TEST_ROUTES=true
# NODE_ENV=test
