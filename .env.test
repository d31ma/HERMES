# ── HERMES Test Environment ──────────────────────────────────────────
# This file is loaded automatically by Bun when running tests.
# All values here are safe defaults for the test suite.

# ── Server ───────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=19000

# ── Security ─────────────────────────────────────────────────────────
JWT_SECRET=test-secret
INBOUND_WEBHOOK_SECRET=test-inbound-secret
EVENTS_WEBHOOK_SECRET=test-events-secret

# ── Adapters ─────────────────────────────────────────────────────────
SMS_ADAPTER=console
SMTP_ADAPTER=console

# ── Test Mode ────────────────────────────────────────────────────────
NODE_ENV=test
HERMES_ENABLE_TEST_ROUTES=true
